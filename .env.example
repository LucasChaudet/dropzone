# Variables de la stack Docker Compose.
# Copier ce fichier en .env (jamais commité) et adapter les valeurs.

# Base PostgreSQL (le mot de passe est à changer en dehors d'un poste de développement)
POSTGRES_DB=dropzone
POSTGRES_USER=dropzone
POSTGRES_PASSWORD=change-me

# API
LOG_LEVEL=INFO
SEED_DEMO_DATA=true

# Ports publiés sur la machine hôte
API_PORT=8000
FRONT_PORT=8080

# Version publiée lancée par compose.release.yml (images ghcr.io, sans le préfixe v)
DROPZONE_VERSION=0.2.0
